# ============================================================
# VARIABLES DE ENTORNO - ssspadron
# Copiá este archivo como ".env" y completá los valores.
# NUNCA subas el .env a Git.
# ============================================================

# ---- SSSALUD -----------------------------------------------
SSS_USER=tu_usuario_sssalud
SSS_PASSWORD=tu_password_sssalud

# ---- OPENAI (para el bot RAG) ------------------------------
OPENAI_API_KEY=sk-...

# ---- WHATSAPP API (Meta Cloud API) -------------------------
# Token de acceso permanente generado en Meta Developers
WHATSAPP_TOKEN=EAAxxxxxxxx

# ID del número de teléfono (no el número en sí, sino el ID de Meta)
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Token que elegís vos para verificar el webhook (puede ser cualquier string)
WHATSAPP_VERIFY_TOKEN=ssspadron_verify_token
